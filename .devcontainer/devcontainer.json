{
  "name": "rag-system",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/rag-system",
  "remoteUser": "appuser",
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--cap-add=SETUID",
    "--cap-add=SETGID"
  ],
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "containerEnv": {
    "TIKTOKEN_CACHE_DIR": "/home/appuser/.cache/tiktoken",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1",
    "HF_HUB_OFFLINE": "1",
    "CLAUDE_CONFIG_DIR": "/home/appuser/.claude"
  },
  "postCreateCommand": "uv sync && npm --prefix frontend ci && uv run python -m backend.app.prefetch_models",
  "mounts": [
    "source=${localWorkspaceFolder},target=/rag-system,type=bind",
    "source=rag_uv_cache,target=/home/appuser/.cache/uv,type=volume",
    "source=rag_huggingface_cache,target=/home/appuser/.cache/huggingface,type=volume",
    "source=rag_tiktoken_cache,target=/home/appuser/.cache/tiktoken,type=volume",
    "source=rag_frontend_node_modules,target=/rag-system/frontend/node_modules,type=volume",
    "source=claude-code-config,target=/home/appuser/.claude,type=volume"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/rag-system/.venv-docker/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  }
}